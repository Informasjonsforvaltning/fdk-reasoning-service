PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

<https://data.norge.no/vocabulary/high-value-dataset-type#eu-hvd>
        a               skos:Concept;
        dct:identifier  "https://data.norge.no/vocabulary/high-value-dataset-type#eu-hvd"^^xsd:anyURI;
        skos:inScheme   <https://data.norge.no/vocabulary/high-value-dataset-type>;
        skos:prefLabel  "High-value dataset (EU)"@en , "Datasett av høy verdi (EU)"@nb , "Datasett av høg verdi (EU)"@nn .

<https://data.norge.no/vocabulary/high-value-dataset-type#national-hvd>
        a               skos:Concept;
