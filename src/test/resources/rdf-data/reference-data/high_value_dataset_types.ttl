        skos:inScheme   <https://data.norge.no/vocabulary/high-value-dataset-type>;
        skos:prefLabel  "National high-value dataset"@en , "Nasjonalt datasett av høy verdi"@nb , "Nasjonalt datasett av høg verdi"@nn .

<https://data.norge.no/vocabulary/high-value-dataset-type#national-basic-data>
