<https://data.norge.no/vocabulary/service-output-type>
        a                    skos:ConceptScheme;
        dct:description      "Kontrollert vokabular med predefinerte tjenesteresultattyper, primært ment for å brukes i forbindelse med å beskrive tjenester og hendelser i henhold til CPSV-AP-NO."@nb , "Controlled vocabulary with predefined output types, primarily meant to be used in connection with describing services and events in accordance with CPSV-AP-NO."@en;
        dct:identifier       "https://data.norge.no/vocabulary/service-output-type"^^xsd:anyURI;
        dct:issued           "2022-01-29"^^xsd:date;
        dct:language         <http://publications.europa.eu/resource/authority/language/NOB> , <http://publications.europa.eu/resource/authority/language/ENG>;
        dct:modified         "2024-08-16"^^xsd:date;
        dct:publisher        <https://organization-catalog.fellesdatakatalog.digdir.no/organizations/991825827>;
        dct:title            "Service output type"@en , "Tjenesteresultattype"@nb;
        uneskos:contains     <https://data.norge.no/vocabulary/service-output-type#financial-benefit> , <https://data.norge.no/vocabulary/service-output-type#rights> , <https://data.norge.no/vocabulary/service-output-type#recogntion> , <https://data.norge.no/vocabulary/service-output-type#declaration> , <https://data.norge.no/vocabulary/service-output-type#permit> , <https://data.norge.no/vocabulary/service-output-type#physical-object> , <https://data.norge.no/vocabulary/service-output-type#financial-obligation> , <https://data.norge.no/vocabulary/service-output-type#identifier>;
        xkos:numberOfLevels  "1"^^xsd:positiveInteger;
        adms:status          <http://publications.europa.eu/resource/authority/dataset-status/DEVELOP>;
        dcat:contactPoint    <https://data.norge.no/vocabulary/service-output-type#Digdir> .
